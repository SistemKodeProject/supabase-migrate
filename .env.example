# ==== DATABASE (pakai Session Pooler, BUKAN direct connection — direct connection sekarang IPv6-only) ====
# Ambil dari: Project Settings > Database > Connect > tab "Session pooler"
SOURCE_HOST=aws-0-<region>.pooler.supabase.com
SOURCE_PORT=5432
SOURCE_DB=postgres
SOURCE_USER=postgres.xxxxxxxxxxxx
SOURCE_PASSWORD=

TARGET_HOST=aws-0-<region>.pooler.supabase.com
TARGET_PORT=5432
TARGET_DB=postgres
TARGET_USER=postgres.yyyyyyyyyyyy
TARGET_PASSWORD=

# ==== PROJECT REF (subdomain di URL project) ====
SOURCE_PROJECT_REF=xxxxxxxxxxxx
TARGET_PROJECT_REF=yyyyyyyyyyyy

# ==== SERVICE ROLE KEY (Project Settings > API) ====
SOURCE_SERVICE_ROLE_KEY=
TARGET_SERVICE_ROLE_KEY=

# ==== STORAGE S3 CREDENTIALS (Project Settings > Storage > S3 Connection > New access key) ====
SOURCE_S3_ACCESS_KEY=
SOURCE_S3_SECRET_KEY=
SOURCE_S3_ENDPOINT=https://xxxxxxxxxxxx.storage.supabase.co/storage/v1/s3

TARGET_S3_ACCESS_KEY=
TARGET_S3_SECRET_KEY=
TARGET_S3_ENDPOINT=https://yyyyyyyyyyyy.storage.supabase.co/storage/v1/s3

# ==== OUTPUT ====
OUTPUT_DIR=./migration_output
