# ==== DATABASE ====
# Use the Session Pooler endpoint, NOT the direct connection.
# Direct connections (db.<ref>.supabase.co) are IPv6-only and fail on many networks.
# Dashboard: Project Settings > Database > Connect > "Session pooler" tab
SOURCE_HOST=aws-0-<region>.pooler.supabase.com
SOURCE_PORT=5432
SOURCE_DB=postgres
SOURCE_USER=postgres.xxxxxxxxxxxx
SOURCE_PASSWORD=

TARGET_HOST=aws-0-<region>.pooler.supabase.com
TARGET_PORT=5432
TARGET_DB=postgres
TARGET_USER=postgres.yyyyyyyyyyyy
TARGET_PASSWORD=

# ==== PROJECT REF (the subdomain in your project URL) ====
SOURCE_PROJECT_REF=xxxxxxxxxxxx
TARGET_PROJECT_REF=yyyyyyyyyyyy

# ==== SERVICE ROLE KEY (Project Settings > API) ====
SOURCE_SERVICE_ROLE_KEY=
TARGET_SERVICE_ROLE_KEY=

# ==== STORAGE S3 CREDENTIALS (Project Settings > Storage > S3 Connection > New access key) ====
SOURCE_S3_ACCESS_KEY=
SOURCE_S3_SECRET_KEY=
SOURCE_S3_ENDPOINT=https://xxxxxxxxxxxx.storage.supabase.co/storage/v1/s3

TARGET_S3_ACCESS_KEY=
TARGET_S3_SECRET_KEY=
TARGET_S3_ENDPOINT=https://yyyyyyyyyyyy.storage.supabase.co/storage/v1/s3

# ==== SUPABASE ACCESS TOKEN (used by 5_migrate_edge_functions.py) ====
# Personal access tokens are per ACCOUNT, not per project. Create them at
# https://supabase.com/dashboard/account/tokens while logged in as the owner
# of each project. If SOURCE and TARGET live in the same account you can set
# the same token for both, or just set SUPABASE_ACCESS_TOKEN.
SOURCE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TARGET_ACCESS_TOKEN=sbp_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
# SUPABASE_ACCESS_TOKEN=

# ==== OUTPUT ====
OUTPUT_DIR=./migration_output

# ==== OPTIONAL: per-table data dump tuning ====
# Comma-separated table names to SKIP from public_data.sql, e.g. large
# webhook/log tables you do not need in the new project:
# EXCLUDE_DATA_TABLES=webhook_logs,audit_log

# Retries per table when the connection drops (default 3) and the base delay
# between retries in seconds (default 5, grows each attempt: 5s, 10s, 15s...):
# DUMP_RETRIES=3
# DUMP_RETRY_BACKOFF=5
