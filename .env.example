# ==== DATABASE (pakai Session Pooler, BUKAN direct connection — direct connection sekarang IPv6-only) ====
# Ambil dari: Project Settings > Database > Connect > tab "Session pooler"
SOURCE_HOST=aws-0-<region>.pooler.supabase.com
SOURCE_PORT=5432
SOURCE_DB=postgres
SOURCE_USER=postgres.xxxxxxxxxxxx
SOURCE_PASSWORD=

TARGET_HOST=aws-0-<region>.pooler.supabase.com
TARGET_PORT=5432
TARGET_DB=postgres
TARGET_USER=postgres.yyyyyyyyyyyy
TARGET_PASSWORD=

# ==== PROJECT REF (subdomain di URL project) ====
SOURCE_PROJECT_REF=xxxxxxxxxxxx
TARGET_PROJECT_REF=yyyyyyyyyyyy

# ==== SERVICE ROLE KEY (Project Settings > API) ====
SOURCE_SERVICE_ROLE_KEY=
TARGET_SERVICE_ROLE_KEY=

# ==== STORAGE S3 CREDENTIALS (Project Settings > Storage > S3 Connection > New access key) ====
SOURCE_S3_ACCESS_KEY=
SOURCE_S3_SECRET_KEY=
SOURCE_S3_ENDPOINT=https://xxxxxxxxxxxx.storage.supabase.co/storage/v1/s3

TARGET_S3_ACCESS_KEY=
TARGET_S3_SECRET_KEY=
TARGET_S3_ENDPOINT=https://yyyyyyyyyyyy.storage.supabase.co/storage/v1/s3

# ==== SUPABASE ACCESS TOKEN (buat 5_migrate_edge_functions.py) ====
# Token ini per-AKUN, bukan per-project. Bikin di
# https://supabase.com/dashboard/account/tokens sambil login pakai akun pemilik
# masing-masing project. Kalau source & target di akun yang sama, boleh isi
# token yang sama di dua-duanya (atau cukup isi SUPABASE_ACCESS_TOKEN aja).
SOURCE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TARGET_ACCESS_TOKEN=sbp_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
# SUPABASE_ACCESS_TOKEN=

# ==== OUTPUT ====
OUTPUT_DIR=./migration_output

# ==== OPSIONAL: dump data public per-tabel (tahan gangguan koneksi) ====
# Nama tabel (comma-separated) yang mau di-SKIP dari public_data.sql, misal
# tabel log/webhook yang gede & gak penting buat di-migrasi:
# EXCLUDE_DATA_TABLES=webhook_logs,some_other_log_table

# Berapa kali retry per-tabel kalau koneksi putus (default 3), dan jeda dasar
# antar-retry dalam detik (default 5, bertambah tiap percobaan: 5s,10s,15s...):
# DUMP_RETRIES=3
# DUMP_RETRY_BACKOFF=5
